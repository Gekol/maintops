# Copy to .env and fill in. Never commit .env. See README.md, "Environment variables".

# Flask session and CSRF signing key (any long random string)
FLASK_SECRET_KEY=

# Lakebase (Postgres) connection string, e.g. postgresql://user:password@host:5432/databricks_postgres?sslmode=require
LAKEBASE_PG_URL=

# Databricks workspace and token (Manny endpoint, CV parsing).
# Token: a personal access token, or a 1-hour OAuth token from `databricks auth token --force-refresh`
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=

# Manny's Model Serving endpoint (default maintops-manny)
MANNY_ENDPOINT=maintops-manny

# SQL warehouse that runs ai_parse_document for CV upload at registration
DATABRICKS_WAREHOUSE_ID=

# Geoapify API key (geocoding and routing)
GEOAPIFY_API_KEY=
